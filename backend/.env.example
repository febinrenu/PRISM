# PRISM backend configuration — copy to .env and adjust as needed.

# Ollama (Phase 2 LLM extraction)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5:3.8b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=60
LLM_BATCH_SIZE=5
# Max clauses sent to the LLM per document with scope=auto (priority-ranked).
LLM_MAX_CANDIDATES=40

# LIME explainability
LIME_NUM_SAMPLES=50
LIME_NUM_FEATURES=12

# ── Phase 3: LLM backend abstraction (Module D/E/F) ──────────────────────────
# ollama | ollama_finetuned | groq
LLM_BACKEND=ollama
OLLAMA_FT_MODEL=prism-legal          # created by training/export_ollama.py
# Groq cloud (production) — free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (frontier baseline). Free tier: Flash models only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Phase 3: RAG corpus (Module D) ───────────────────────────────────────────
CORPUS_COLLECTION=prism_legal_corpus
RAG_TOP_K=8

# ── Phase 3: simulation / segmentation ───────────────────────────────────────
SIM_CALIBRATION=nsso                 # nsso | legacy
SEGMENTATION_MODE=structural         # structural | semantic

# ── Phase 3: production auth, DB, storage (Module F) ─────────────────────────
# Leave DATABASE_URL empty to use a local SQLite file (data/prism.db).
DATABASE_URL=                        # postgresql://user:pass@ep-xxx.neon.tech/prism
JWT_SECRET=change-me-in-production
API_RATE_LIMIT=100/hour
# Whoever registers/logs in with this email is promoted to admin (reaches /admin).
PRISM_ADMIN_EMAIL=
# Cloudflare R2 (S3-compatible). Leave empty to keep uploads on local disk.
R2_ENDPOINT=
CLOUDFLARE_R2_KEY=
CLOUDFLARE_R2_SECRET=
R2_BUCKET=prism-uploads
